    <style>
        :root {
            --bg-main: #0f172a;
            --bg-card: #1e293b;
            --accent: #f59e0b;
            --accent-teal: #38bdf8;
            --whatsapp-green: #25d366;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            line-height: 1.5;
            padding: 20px;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 10px 0;
        }

        /* Hero Header Workspace Panel */
        header {
            background: var(--bg-card);
            border: 1px solid var(--border);
            padding: 35px 30px;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);
            margin-bottom: 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 25px;
            text-align: center;
        }

        @media (min-width: 768px) {
            header {
                flex-direction: row;
                text-align: left;
                gap: 35px;
            }
        }

        .profile-img {
            width: 145px;
            height: 145px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--accent);
            box-shadow: 0 0 25px rgba(245, 158, 11, 0.2.5);
        }

        .header-info {
            flex: 1;
        }

        .profile-title {
            font-size: 2.5rem;
            font-weight: 800;
            letter-spacing: -1px;
            background: linear-gradient(to right, #ffffff, #cbd5e1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 6px;
        }

        .tagline {
            color: var(--accent);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-size: 0.95rem;
            margin-bottom: 20px;
        }

        .links-grid {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .contact-pill {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            color: var(--text-muted);
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .contact-pill:hover {
            border-color: var(--accent-teal);
            color: #ffffff;
            background: rgba(56, 189, 248, 0.08);
            transform: translateY(-2px);
        }

        /* Interactive Connected Messaging Node */
        .btn-whatsapp {
            background: rgba(37, 211, 102, 0.08);
            border-color: rgba(37, 211, 102, 0.4);
            color: #25d366;
            font-weight: 600;
        }

        .btn-whatsapp:hover {
            background: var(--whatsapp-green);
            color: #0f172a;
            border-color: var(--whatsapp-green);
            box-shadow: 0 0 20px rgba(37, 211, 102, 0.4);
        }

        .pill-icon {
            width: 15px;
            height: 15px;
            fill: currentColor;
            display: inline-block;
            vertical-align: middle;
        }

        /* Layout Architecture Split */
        .grid-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 30px;
        }

        @media (min-width: 768px) {
            .grid-layout {
                grid-template-columns: 2fr 1fr;
            }
        }

        .panel {
            background: var(--bg-card);
            border: 1px solid var(--border);
            padding: 30px;
            border-radius: 16px;
            margin-bottom: 25px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .section-heading {
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 22px;
            padding-left: 12px;
            border-left: 4px solid var(--accent);
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .pitch-box {
            background: rgba(245, 158, 11, 0.01);
            border: 1px dashed var(--border);
            padding: 18px;
            border-radius: 12px;
            color: #cbd5e1;
            font-size: 0.95rem;
            text-align: justify;
            line-height: 1.6;
        }

        /* Structural Operations Feed Timeline */
        .timeline-container {
            margin-top: 15px;
        }

        .timeline-item {
            border-left: 2px solid var(--border);
            padding-left: 22px;
            position: relative;
            margin-bottom: 30px;
        }

        .timeline-item:last-child {
            margin-bottom: 10px;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -6px;
            top: 6px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--accent-teal);
            transition: all 0.2s ease;
        }

        .timeline-item:hover::before {
            background: var(--accent);
            box-shadow: 0 0 10px var(--accent);
        }

        .timeline-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 6px;
        }

        .job-title {
            font-weight: 700;
            font-size: 1.1rem;
            color: #ffffff;
        }

        .job-date {
            color: var(--accent-teal);
            font-size: 0.85rem;
            font-weight: 600;
            background: rgba(56, 189, 248, 0.1);
            padding: 3px 10px;
            border-radius: 20px;
        }

        .job-meta {
            color: var(--accent);
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .bullets-list {
            list-style-type: square;
            padding-left: 18px;
            color: var(--text-muted);
            font-size: 0.9rem;
            text-align: justify;
        }

        .bullets-list li {
            margin-bottom: 6px;
        }

        /* High-Definition University Logo Adapters */
        .logo-badge-container {
            display: flex;
            align-items: center;
            gap: 16px;
            background: rgba(255, 255, 255, 0.01);
            border: 1px solid var(--border);
            padding: 14px;
            border-radius: 12px;
            margin-bottom: 12px;
            transition: border-color 0.2s ease;
        }

        .logo-badge-container:hover {
            border-color: rgba(245, 158, 11, 0.25);
        }

        .uni-logo-img {
            width: 54px;
            height: 54px;
            object-fit: contain; 
            border-radius: 8px;
            background-color: #ffffff;
            padding: 5px;
            border: 1px solid #cbd5e1;
            image-rendering: -webkit-optimize-contrast;
            image-rendering: crisp-edges;
            display: block;
            flex-shrink: 0;
        }

        .logo-details {
            flex: 1;
        }

        .logo-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: #ffffff;
        }

        .logo-issuer {
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 500;
            margin-top: 2px;
        }

        /* Scalable Skill Ecosystem Panels */
        .tag-cloud {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tag {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            color: #cbd5e1;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .tag-accent {
            border-color: rgba(245, 158, 11, 0.2.5);
            color: var(--accent);
            background: rgba(245, 158, 11, 0.02);
            font-weight: 600;
